# Final pwiz/Skyline container image. Built on top of the symlink-safe
# wine-devel base (Dockerfile.wine-dotnet-devel) and pre-extracted,
# workflow-pruned pwiz binaries (./pwiz-artifacts/, populated by build.sh).
#
# Differences from the upstream container/Dockerfile:
#   - FROM points at the local devel-flavored base instead of the
#     wine-staging-flavored upstream base.
#   - No two-stage tarball-unpack builder. Artifacts are copied directly
#     from ./pwiz-artifacts/, which build.sh extracts from the published
#     image and then prunes.
#   - CMD uses wine_anyuser instead of wine64_anyuser. Modern Wine merged
#     wow64 and no longer ships a separate wine64 binary, so the upstream
#     CMD was already broken on any wine 9.x+ image, including the
#     published one.

FROM local/wine-dotnet:winedevel10.6-net4.8-x64
COPY pwiz-artifacts/ /wineprefix64/drive_c/pwiz/

ENV CONTAINER_GITHUB=https://github.com/ProteoWizard/container

LABEL description="Convert MS RAW vendor files to open formats or analyze them with Skyline (symlink-safe wine-devel build)."
LABEL website=https://github.com/ProteoWizard/container
LABEL documentation=https://github.com/ProteoWizard/container
LABEL license=https://github.com/ProteoWizard/container
LABEL tags="Metabolomics,Proteomics,MassSpectrometry"

ENV WINEDEBUG -all
ENV WINEPATH "C:\pwiz;C:\pwiz\skyline"

# sudo + wine wrappers, matching upstream's interface
RUN apt-get update && \
    apt-get -y install sudo && \
    apt-get -y clean && \
    echo "ALL     ALL=NOPASSWD:  ALL" >> /etc/sudoers && \
    echo '#!/bin/sh\nsudo -E -H -u root wine64 "$@"' > /usr/bin/wine64_anyuser && \
    echo '#!/bin/sh\nsudo -E -H -u root wine "$@"' > /usr/bin/wine_anyuser && \
    chmod ugo+rx /usr/bin/wine*anyuser && \
    rm -rf \
      /var/lib/apt/lists/* \
      /usr/share/doc \
      /usr/share/doc-base \
      /usr/share/man \
      /usr/share/locale \
      /usr/share/zoneinfo

# Galaxy UIDs (preserved from upstream so the image is a drop-in replacement)
RUN groupadd -r galaxy -g 1450 && \
    useradd -u 1450 -r -g galaxy -d /home/galaxy -c "Galaxy user" galaxy && \
    useradd -u 1000 -r -g galaxy -d /home/galaxy -c "Galaxy docker user" galaxy_docker && \
    useradd -u 2000 -r -g galaxy -d /home/galaxy -c "Galaxy Travis user" galaxy_travis && \
    useradd -u 999 -r -g galaxy -d /home/galaxy -c "usegalaxy.eu user" galaxy_eu

RUN mkdir /data
WORKDIR /data

CMD ["wine_anyuser", "msconvert"]

ADD mywine /usr/bin/
RUN chmod ugo+rx /usr/bin/mywine

# Apptainer compatibility: TMP/TEMP map to host /tmp through Z:\tmp
RUN echo "\"TMP\"=\"Z:\\\\\\\\tmp\"" >> /wineprefix64/user.reg
